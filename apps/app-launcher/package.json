{
  "name": "app-launcher",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build-app-launcher-ui": "pnpm --dir ../ui run build:app-launcher",
    "build": "pnpm build-app-launcher-ui && tsc && vite build && electron-builder && pnpm copy-release",
    "copy-release": "cross-env rm -rf ../ui/resources/launcher/winemacapp.app && cross-env cp -R ./release/0.0.0/mac/winemacapp.app ../ui/resources/launcher",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.6.1",
    "chokidar": "^4.0.3",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.11.0",
    "plist": "^3.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.15.0",
    "reactjs-shared-ui": "^0.0.3",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.13.6",
    "ui": "workspace:^",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "cross-env": "^10.0.0",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.2.2",
    "vite": "^5.1.6",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-environment": "^1.1.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "main": "dist-electron/main.js"
}
