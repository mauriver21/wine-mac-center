{
  "name": "ui",
  "version": "0.0.1",
  "productName": "Wine Mac Center",
  "description": "An Electron application with React and TypeScript",
  "main": "./out/main/index.js",
  "author": "example.com",
  "homepage": "https://electron-vite.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "cross-env VITE_APP_ENV=development electron-vite dev",
    "dev:integration": "cross-env VITE_APP_ENV=integration electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && VITE_APP_ENV=production electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "bump-patch-version": "npm version patch -m 'chore: bump patch version to %s'"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "@heroicons/react": "^2.2.0",
    "@reduxjs/toolkit": "^2.6.1",
    "axios": "^1.8.4",
    "chokidar": "^4.0.3",
    "electron-updater": "^6.3.9",
    "notistack": "^3.0.2",
    "plist": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.2.0",
    "react-virtuoso": "^4.12.6",
    "reactjs-ui-core": "^0.0.24",
    "reactjs-ui-form-fields": "^0.0.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^10.0.0",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-environment": "^1.1.3",
    "vite-tsconfig-paths": "^4.3.2"
  },
  "build": {
    "mac": {
      "artifactName": "${productName}.${ext}",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ]
  }
}
