{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "./src/renderer/src/env.d.ts",
    "./src/renderer/src/**/*",
    "./src/renderer/src/**/*.tsx",
    "./src/preload/*.d.ts",
    "./src/types/*",
    "./src/types.d/*.d.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",    
    "moduleResolution": "bundler",
    "paths": {
      "@api-clients/*": ["./src/renderer/src/api-clients/*"],
      "@assets/*": ["./src/renderer/src/assets/*"],
      "@components/*": ["./src/renderer/src/components/*"],
      "@constants/*": ["./src/renderer/src/constants/*"],
      "@contexts/*": ["./src/renderer/src/contexts/*"],
      "@hocs/*": ["./src/renderer/src/hocs/*"],
      "@hooks/*": ["./src/renderer/src/hooks/*"],
      "@icons/*": ["./src/renderer/src/assets/icons/*"],
      "@interfaces/*": ["./src/renderer/src/interfaces/*"],
      "@i18n": ["./src/renderer/src/i18n"],
      "@i18n/*": ["./src/renderer/src/i18n/*"],
      "@layouts/*": ["./src/renderer/src/layouts/*"],
      "@mocks/*": ["./src/renderer/src/mocks/*"],
      "@models/*": ["./src/renderer/src/models/*"],
      "@pages/*": ["./src/renderer/src/pages/*"],
      "@routes": ["./src/renderer/src/routes"],
      "@states": ["./src/renderer/src/states"],
      "@states/*": ["./src/renderer/src/states/*"],
      "@store": ["./src/renderer/src/store"],
      "@themes": ["./src/renderer/src/themes"],
      "@utils/*": ["./src/renderer/src/utils/*"],
      "@app-launcher/assets/*": ["./src/renderer/src/externals/app-launcher/assets/*"],
      "@app-launcher/components/*": ["./src/renderer/src/externals/app-launcher/components/*"],
      "@app-launcher/contexts/*": ["./src/renderer/src/externals/app-launcher/contexts/*"],
      "@app-launcher/hooks/*": ["./src/renderer/src/externals/app-launcher/hooks/*"],
      "@app-launcher/layouts/*": ["./src/renderer/src/externals/app-launcher/layouts/*"],
      "@app-launcher/routes": ["./src/renderer/src/externals/app-launcher/routes"],
      "@app-launcher": ["./src/renderer/src/externals/app-launcher"],
    }
  }
}
