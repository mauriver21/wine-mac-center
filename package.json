{
  "name": "wine-mac-center",
  "version": "1.0.0-alpha",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build:all": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "preview": "pnpm -r --parallel --if-present preview",
    "format": "pnpm -r --if-present format",
    "typecheck": "pnpm -r --if-present typecheck",
    "www:dev": "pnpm --filter www dev",
    "www:build": "pnpm --filter www build",
    "www:lint": "pnpm --filter www lint",
    "www:preview": "pnpm --filter www preview",
    "ui:dev": "pnpm --filter ui dev",
    "ui:build:mac": "pnpm --filter ui build:mac",
    "ui:build": "pnpm --filter ui build",
    "ui:lint": "pnpm --filter ui lint",
    "ui:typecheck": "pnpm --filter ui typecheck",
    "ui:preview": "pnpm --filter ui start",
    "app-launcher:dev": "pnpm --filter app-launcher dev",
    "app-launcher:build": "pnpm --filter app-launcher build",
    "app-launcher:lint": "pnpm --filter app-launcher lint",
    "app-launcher:preview": "pnpm --filter app-launcher preview",
    "build": "pnpm app-launcher:build && pnpm ui:build:mac"
  },
  "keywords": [],
  "author": "Mauricio Rivera",
  "license": "ISC",
  "resolutions": {
    "rollup": "4.15.0"
  }
}
